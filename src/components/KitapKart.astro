---
import { Image } from "astro:assets";
import Yildizlar from "./Yildizlar.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  kitap: CollectionEntry<"kitaplar">;
}
const { kitap } = Astro.props;
const { data, id } = kitap;

const durumEtiket: Record<string, string> = {
  okudum: "Okudum",
  okuyorum: "Okuyorum",
  okunacak: "Okunacak",
};
---

<article class="kitap-kart">
  <a href={`/kitaplar/${id}`} class="kitap-kapak">
    {
      data.kapak ? (
        <Image src={data.kapak} alt={data.baslik} width={240} height={360} />
      ) : (
        <span class="kapak-yok">{data.baslik}</span>
      )
    }
  </a>
  <div class="kitap-bilgi">
    <span class="durum">{durumEtiket[data.durum]}</span>
    <h3>
      <a href={`/kitaplar/${id}`}>{data.baslik}</a>
    </h3>
    <p class="yazar">{data.yazar}</p>
    <Yildizlar puan={data.puan} />
  </div>
</article>

<style>
  .kitap-kart {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .kitap-kapak {
    display: block;
    aspect-ratio: 2 / 3;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--cizgi);
    background: var(--kagit-koyu);
    box-shadow: 0 8px 18px -10px var(--golge);
    transition: transform 0.15s ease;
  }
  .kitap-kapak:hover {
    transform: translateY(-3px);
  }
  .kitap-kapak :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kapak-yok {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1rem;
    text-align: center;
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--murekkep-soluk);
  }
  .durum {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--zeytin);
  }
  .kitap-bilgi h3 {
    margin: 0.15rem 0 0.1rem;
    font-size: 1.1rem;
  }
  .kitap-bilgi h3 a {
    color: var(--murekkep);
  }
  .kitap-bilgi h3 a:hover {
    color: var(--terracotta-koyu);
    text-decoration: none;
  }
  .yazar {
    margin: 0 0 0.4rem;
    color: var(--murekkep-soluk);
    font-size: 0.9rem;
    font-style: italic;
  }
</style>
