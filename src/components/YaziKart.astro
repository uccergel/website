---
import { Image } from "astro:assets";
import { tarihYaz, isoTarih } from "../utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  yazi: CollectionEntry<"yazilar">;
}
const { yazi } = Astro.props;
const { data, id } = yazi;
---

<article class="yazi-kart">
  {
    data.kapak && (
      <a href={`/yazilar/${id}`} class="kart-gorsel">
        <Image src={data.kapak} alt={data.baslik} width={720} height={420} />
      </a>
    )
  }
  <div class="kart-govde">
    <time class="kart-tarih" datetime={isoTarih(data.tarih)}>
      {tarihYaz(data.tarih)}
    </time>
    <h3 class="kart-baslik">
      <a href={`/yazilar/${id}`}>{data.baslik}</a>
    </h3>
    {data.ozet && <p class="kart-ozet">{data.ozet}</p>}
    {
      data.etiketler.length > 0 && (
        <div class="kart-etiketler">
          {data.etiketler.map((e) => (
            <span class="etiket">#{e}</span>
          ))}
        </div>
      )
    }
  </div>
</article>

<style>
  .yazi-kart {
    display: flex;
    flex-direction: column;
    background: var(--kagit-koyu);
    border: 1px solid var(--cizgi);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .yazi-kart:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -12px var(--golge);
  }
  .kart-gorsel {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .kart-gorsel :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .kart-govde {
    padding: 1.25rem 1.35rem 1.4rem;
  }
  .kart-tarih {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--terracotta);
  }
  .kart-baslik {
    margin: 0.35rem 0 0.5rem;
    font-size: 1.3rem;
  }
  .kart-baslik a {
    color: var(--murekkep);
  }
  .kart-baslik a:hover {
    color: var(--terracotta-koyu);
    text-decoration: none;
  }
  .kart-ozet {
    color: var(--murekkep-soluk);
    margin: 0 0 0.9rem;
    font-size: 0.97rem;
  }
  .kart-etiketler {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
