---
import { SITE, SOSYAL } from "../config";
import Icon from "./Icon.astro";
const yil = new Date().getFullYear();
---

<footer class="site-alt">
  <div class="kapsayici alt-ic">
    <div>
      <p class="alt-isim">{SITE.isim}</p>
      <p class="alt-not">Yazılar, fotoğraflar, kitaplar ve dağınık notlar.</p>
    </div>

    <div class="alt-sosyal">
      {
        SOSYAL.map((s) => (
          <a
            href={s.url}
            class="sosyal-link"
            aria-label={s.ad}
            rel="me noopener"
            target={s.url.startsWith("mailto:") ? undefined : "_blank"}
          >
            <Icon ad={s.ikon} boyut={20} />
          </a>
        ))
      }
      <a href="/rss.xml" class="sosyal-link" aria-label="RSS">
        <Icon ad="rss" boyut={20} />
      </a>
    </div>
  </div>
  <div class="kapsayici alt-telif">
    <span>© {yil} {SITE.isim}</span>
    <span>Astro ile hazırlandı 🛠️</span>
  </div>
</footer>

<style>
  .site-alt {
    margin-top: 5rem;
    border-top: 1px solid var(--cizgi);
    background: var(--kagit-koyu);
    padding: 2.5rem 0 1.5rem;
  }
  .alt-ic {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .alt-isim {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
  }
  .alt-not {
    color: var(--murekkep-soluk);
    margin: 0.25rem 0 0;
  }
  .alt-sosyal {
    display: flex;
    gap: 0.5rem;
  }
  .sosyal-link {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--cizgi);
    color: var(--murekkep-soluk);
    background: var(--kagit);
  }
  .sosyal-link:hover {
    color: var(--terracotta);
    border-color: var(--deri);
    text-decoration: none;
  }
  .alt-telif {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--cizgi);
    color: var(--murekkep-soluk);
    font-size: 0.85rem;
  }
</style>
