---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SOSYAL, ILGI_ALANLARI } from "../config";
---

<BaseLayout
  baslik="Hakkımda"
  aciklama="Uğur Cem Çergel — iletişim yöneticisi, kimyager, bilgisayar mühendisi ve hobi zanaatkârı."
>
  <section class="kapsayici hakkimda">
    <div class="foto-sutun">
      <img src="/images/profil.jpg" alt="Uğur Cem Çergel" width="220" height="220" />
      <div class="sosyal">
        {
          SOSYAL.map((s) => (
            <a
              href={s.url}
              aria-label={s.ad}
              target={s.url.startsWith("mailto:") ? undefined : "_blank"}
              rel="me noopener"
            >
              <Icon ad={s.ikon} boyut={20} />
            </a>
          ))
        }
      </div>
    </div>

    <div class="metin-sutun">
      <p class="ust-baslik">Merhaba</p>
      <h1>Ben Uğur Cem Çergel</h1>

      <p class="giris">
        İletişim biriminde yöneticilik yapıyorum. Kimya bölümü ve bilgisayar
        mühendisliği olmak üzere iki farklı alanda eğitim aldım; bu ikisinin
        kesişiminde hem analitik hem de üretken düşünmeyi seviyorum.
      </p>

      <p>
        Yazılımla hobi olarak ilgileniyorum — küçük araçlar yazmak, bir şeyleri
        otomatikleştirmek ve yeni teknolojileri kurcalamak benim için bir tür
        dinlenme. İşin ekrandan uzak kısmında ise ellerimle bir şeyler üretmek
        beni mutlu ediyor: deri işçiliğiyle cüzdan ve kemerler dikiyor, ahşapla
        küçük objeler yapıyorum. Müzik de hayatımın değişmez parçası; bateri ve
        bas gitar çalarak ritmin peşinden gidiyorum.
      </p>

      <p>
        Bu blogu; öğrendiklerimi, ürettiklerimi, okuduğum kitapları ve faydalı
        bulduğum bağlantıları toparlamak için açtım. Hem kendime bir defter hem
        de uğrayanlara küçük bir köşe olsun istedim.
      </p>

      <h2>İlgilendiğim şeyler</h2>
      <ul class="ilgi-liste">
        {
          ILGI_ALANLARI.map((i) => (
            <li>
              <span class="ilgi-ikon">
                <Icon ad={i.ikon} boyut={20} />
              </span>
              <span>
                <strong>{i.ad}.</strong> {i.aciklama}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="iletisim-kutu">
        <p>
          Bir şey sormak, fikir alışverişi yapmak ya da sadece merhaba demek
          istersen yazmaktan çekinme.
        </p>
        <a href="mailto:ugurcemcergel@gmail.com" class="dugme">
          <Icon ad="mail" boyut={18} /> E-posta gönder
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hakkimda {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 3rem;
    align-items: start;
    padding: 3rem 0;
  }
  .foto-sutun {
    position: sticky;
    top: 88px;
    text-align: center;
  }
  .foto-sutun img {
    width: 100%;
    height: auto;
    border-radius: 20px;
    border: 4px solid var(--kagit-koyu);
    box-shadow: 0 18px 40px -18px var(--golge), 0 0 0 1px var(--cizgi);
  }
  .sosyal {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1rem;
    color: var(--murekkep-soluk);
  }
  .sosyal a:hover {
    color: var(--terracotta);
  }
  .metin-sutun h1 {
    margin: 0.3rem 0 1rem;
  }
  .giris {
    font-size: 1.2rem;
    color: var(--murekkep);
  }
  .metin-sutun h2 {
    margin-top: 2rem;
  }
  .ilgi-liste {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.8rem;
  }
  .ilgi-liste li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .ilgi-ikon {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: color-mix(in srgb, var(--zeytin) 16%, transparent);
    color: var(--zeytin);
    margin-top: 2px;
  }
  .iletisim-kutu {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--kagit-koyu);
    border: 1px solid var(--cizgi);
    border-radius: var(--radius);
  }
  .iletisim-kutu p {
    margin-top: 0;
  }

  @media (max-width: 720px) {
    .hakkimda {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 2rem 0;
    }
    .foto-sutun {
      position: static;
      max-width: 180px;
    }
  }
</style>
