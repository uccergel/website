---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import YaziKart from "../components/YaziKart.astro";
import Icon from "../components/Icon.astro";
import { ILGI_ALANLARI, SOSYAL } from "../config";
import { yeniden } from "../utils";

const yazilar = yeniden(
  (await getCollection("yazilar")).filter((y) => !y.data.taslak),
).slice(0, 3);
---

<BaseLayout>
  <!-- Tanıtım / hero -->
  <section class="hero">
    <div class="kapsayici hero-ic">
      <div class="hero-metin">
        <p class="ust-baslik">Merhaba, ben Uğur Cem 👋</p>
        <h1>Yazılım, el işçiliği ve müzik üzerine kişisel köşem.</h1>
        <p class="hero-aciklama">
          İletişim biriminde yöneticilik yapıyorum; kimya ve bilgisayar
          mühendisliği geçmişim var. Hobi olarak kod yazar, deri ve ahşap işler,
          bateri ile bas gitar çalarım. Burada öğrendiklerimi, ürettiklerimi ve
          okuduklarımı paylaşıyorum.
        </p>
        <div class="hero-dugmeler">
          <a href="/yazilar" class="dugme">
            Yazıları oku <Icon ad="ok" boyut={18} />
          </a>
          <a href="/hakkimda" class="dugme ikincil">Hakkımda</a>
        </div>
        <div class="hero-sosyal">
          {
            SOSYAL.map((s) => (
              <a
                href={s.url}
                aria-label={s.ad}
                target={s.url.startsWith("mailto:") ? undefined : "_blank"}
                rel="me noopener"
              >
                <Icon ad={s.ikon} boyut={20} />
              </a>
            ))
          }
        </div>
      </div>
      <div class="hero-foto">
        <img src="/images/profil.jpg" alt="Uğur Cem Çergel" width="280" height="280" />
      </div>
    </div>
  </section>

  <!-- İlgi alanları -->
  <section class="kapsayici bolum">
    <h2 class="bolum-baslik">Neyle uğraşıyorum?</h2>
    <div class="ilgi-izgara">
      {
        ILGI_ALANLARI.map((i) => (
          <div class="ilgi-kart">
            <span class="ilgi-ikon">
              <Icon ad={i.ikon} boyut={26} />
            </span>
            <h3>{i.ad}</h3>
            <p>{i.aciklama}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Son yazılar -->
  <section class="kapsayici bolum">
    <div class="bolum-ust">
      <h2 class="bolum-baslik">Son yazılar</h2>
      <a href="/yazilar" class="tum-link">Tümü <Icon ad="ok" boyut={16} /></a>
    </div>
    {
      yazilar.length > 0 ? (
        <div class="yazi-izgara">
          {yazilar.map((y) => (
            <YaziKart yazi={y} />
          ))}
        </div>
      ) : (
        <p class="bos-not">Henüz yazı yok — yakında ilk yazı burada olacak.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--cizgi);
    padding: 2.5rem 0 3rem;
  }
  .hero-ic {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2.5rem;
    align-items: center;
  }
  .hero-metin h1 {
    margin: 0.4rem 0 0.8rem;
  }
  .hero-aciklama {
    color: var(--murekkep-soluk);
    font-size: 1.12rem;
    max-width: 38rem;
  }
  .hero-dugmeler {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .hero-sosyal {
    display: flex;
    gap: 0.9rem;
    margin-top: 1.75rem;
    color: var(--murekkep-soluk);
  }
  .hero-sosyal a:hover {
    color: var(--terracotta);
  }
  .hero-foto img {
    width: clamp(180px, 30vw, 280px);
    height: clamp(180px, 30vw, 280px);
    border-radius: 18px;
    object-fit: cover;
    border: 4px solid var(--kagit-koyu);
    box-shadow: 0 18px 40px -18px var(--golge), 0 0 0 1px var(--cizgi);
    transform: rotate(2deg);
  }

  .bolum {
    margin-top: 3.5rem;
  }
  .bolum-baslik {
    position: relative;
    display: inline-block;
  }
  .bolum-baslik::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 48px;
    height: 4px;
    border-radius: 4px;
    background: var(--hardal);
  }
  .bolum-ust {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .tum-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .ilgi-izgara {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.1rem;
    margin-top: 1.5rem;
  }
  .ilgi-kart {
    background: var(--kagit-koyu);
    border: 1px solid var(--cizgi);
    border-radius: var(--radius);
    padding: 1.4rem;
  }
  .ilgi-ikon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--terracotta) 14%, transparent);
    color: var(--terracotta);
    margin-bottom: 0.8rem;
  }
  .ilgi-kart h3 {
    margin: 0 0 0.3rem;
    font-size: 1.15rem;
  }
  .ilgi-kart p {
    margin: 0;
    color: var(--murekkep-soluk);
    font-size: 0.95rem;
  }

  .yazi-izgara {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .bos-not {
    color: var(--murekkep-soluk);
    font-style: italic;
  }

  @media (max-width: 720px) {
    .hero-ic {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .hero-foto {
      order: -1;
    }
  }
</style>
