---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// src/galeri/ klasörüne fotoğraf eklemen yeterli — otomatik listelenir.
const dosyalar = import.meta.glob<{ default: ImageMetadata }>(
  "../galeri/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}",
  { eager: true },
);

const gorseller = Object.entries(dosyalar)
  .sort(([a], [b]) => b.localeCompare(a))
  .map(([yol, mod]) => ({
    src: mod.default,
    ad: yol
      .split("/")
      .pop()!
      .replace(/\.[^.]+$/, "")
      .replace(/[-_]/g, " "),
  }));
---

<BaseLayout
  baslik="Galeri"
  aciklama="Atölyeden, gezilerden ve günlük hayattan fotoğraflar."
>
  <section class="kapsayici sayfa-bas">
    <p class="ust-baslik">Fotoğraflar</p>
    <h1>Galeri</h1>
    <p class="sayfa-aciklama">
      Atölyeden kareler, el işleri, enstrümanlar ve yolda gördüklerim.
    </p>
  </section>

  <section class="kapsayici">
    {
      gorseller.length > 0 ? (
        <div class="duvar">
          {gorseller.map((g) => (
            <figure class="kare">
              <Image
                src={g.src}
                alt={g.ad}
                widths={[400, 800]}
                sizes="(max-width: 700px) 100vw, 360px"
                loading="lazy"
              />
              {g.ad && <figcaption>{g.ad}</figcaption>}
            </figure>
          ))}
        </div>
      ) : (
        <p class="bos-not">
          Henüz fotoğraf yok. <code>src/galeri/</code> klasörüne görsel ekleyince
          burada otomatik görünecek.
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .sayfa-bas {
    padding: 2.5rem 0 2rem;
  }
  .sayfa-bas h1 {
    margin: 0.3rem 0 0.5rem;
  }
  .sayfa-aciklama {
    color: var(--murekkep-soluk);
    font-size: 1.1rem;
    max-width: 40rem;
    margin: 0;
  }
  .duvar {
    column-count: 3;
    column-gap: 1rem;
  }
  .kare {
    margin: 0 0 1rem;
    break-inside: avoid;
    background: var(--kagit-koyu);
    border: 1px solid var(--cizgi);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 6px 16px -10px var(--golge);
  }
  .kare :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .kare figcaption {
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    color: var(--murekkep-soluk);
    text-transform: capitalize;
  }
  .bos-not {
    color: var(--murekkep-soluk);
    font-style: italic;
  }
  @media (max-width: 900px) {
    .duvar {
      column-count: 2;
    }
  }
  @media (max-width: 560px) {
    .duvar {
      column-count: 1;
    }
  }
</style>
