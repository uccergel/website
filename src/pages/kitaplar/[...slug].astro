---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import Yildizlar from "../../components/Yildizlar.astro";
import { tarihYaz } from "../../utils";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async () => {
  const kitaplar = (await getCollection("kitaplar")).filter(
    (k) => !k.data.taslak,
  );
  return kitaplar.map((kitap) => ({
    params: { slug: kitap.id },
    props: { kitap },
  }));
}) satisfies GetStaticPaths;

const { kitap } = Astro.props;
const { data } = kitap;
const { Content } = await render(kitap);

const durumEtiket: Record<string, string> = {
  okudum: "Okudum",
  okuyorum: "Okuyorum",
  okunacak: "Okunacak",
};
---

<BaseLayout
  baslik={`${data.baslik} — ${data.yazar}`}
  aciklama={data.ozet}
  gorsel={data.kapak?.src ?? "/images/profil.jpg"}
>
  <div class="kapsayici">
    <a href="/kitaplar" class="geri">
      <Icon ad="ok" boyut={16} class="ters" /> Tüm kitaplar
    </a>
  </div>

  <article class="kapsayici kitap-detay">
    <div class="kapak-sutun">
      {
        data.kapak ? (
          <Image
            src={data.kapak}
            alt={data.baslik}
            width={300}
            height={450}
            class="kapak"
          />
        ) : (
          <div class="kapak kapak-yok">{data.baslik}</div>
        )
      }
    </div>

    <div class="bilgi-sutun">
      <span class="durum">{durumEtiket[data.durum]}</span>
      <h1>{data.baslik}</h1>
      <p class="yazar">{data.yazar}</p>
      <div class="meta">
        <Yildizlar puan={data.puan} />
        <span class="okuma-tarihi">{tarihYaz(data.tarih)}</span>
      </div>
      {data.ozet && <p class="ozet">{data.ozet}</p>}

      <div class="yorum icerik">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .geri {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    font-size: 0.9rem;
    margin: 2rem 0 1.25rem;
  }
  .geri :global(.ters) {
    transform: rotate(180deg);
  }
  .kitap-detay {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .kapak-sutun {
    position: sticky;
    top: 88px;
  }
  .kapak {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--cizgi);
    box-shadow: 0 18px 40px -18px var(--golge);
  }
  .kapak-yok {
    aspect-ratio: 2 / 3;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 1rem;
    background: var(--kagit-koyu);
    font-family: var(--serif);
    color: var(--murekkep-soluk);
  }
  .durum {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--zeytin);
  }
  .bilgi-sutun h1 {
    margin: 0.25rem 0 0.3rem;
  }
  .yazar {
    font-style: italic;
    color: var(--murekkep-soluk);
    font-size: 1.15rem;
    margin: 0 0 0.75rem;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .okuma-tarihi {
    font-size: 0.9rem;
    color: var(--murekkep-soluk);
  }
  .ozet {
    font-size: 1.1rem;
    color: var(--murekkep);
    border-left: 4px solid var(--hardal);
    padding-left: 1rem;
  }
  .yorum {
    margin-top: 1.5rem;
    border-top: 1px solid var(--cizgi);
    padding-top: 1.5rem;
  }
  .icerik :global(img) {
    border-radius: var(--radius);
    margin: 1.25rem 0;
    border: 1px solid var(--cizgi);
  }

  @media (max-width: 720px) {
    .kitap-detay {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .kapak-sutun {
      position: static;
      max-width: 200px;
    }
  }
</style>
